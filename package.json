{
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "mysql2": "^3.24.6",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "name": "tickwatch-uk",
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev --port ${PORT:-3000} --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-mysql.mjs",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node dist-server/main.js",
    "server:dev": "nest start --watch --path server/tsconfig.json",
    "test:api": "node tests/p0-api.cjs && node tests/p1-api.cjs && node tests/p1-storage.cjs"
  },
  "type": "module",
  "version": "0.0.0"
}
